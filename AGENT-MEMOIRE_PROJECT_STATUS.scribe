invariants:
  - id: "INV-F001"
    status: "active"
    l0_abstract: "Maintain senior production engineering posture across the session."
  - id: "INV-F002"
    status: "active"
    l0_abstract: "Never hardcode secrets; use environment configuration."
  - id: "INV-F003"
    status: "active"
    l0_abstract: "Preserve existing behavior; avoid regressions."
  - id: "INV-F004"
    status: "active"
    l0_abstract: "Deliver complete code without placeholders."
  - id: "INV-F005"
    status: "active"
    l0_abstract: "Explain to the user in French; keep code identifiers and comments in English."
  - id: "INV-F006"
    status: "active"
    l0_abstract: "Consult SCRIBE before code changes."
  - id: "INV-F007"
    status: "active"
    l0_abstract: "Require human validation before irreversible actions."
  - id: "INV-F008"
    status: "active"
    l0_abstract: "Bind critical or high scars to tests."
  - id: "INV-F009"
    status: "active"
    l0_abstract: "Update SCRIBE incrementally; never overwrite historical memory."
  - id: "INV-F010"
    status: "active"
    l0_abstract: "Read Graphify report first when graphify-out is present."
scars:
  - id: "SCAR-001"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-24"
    schema_patch_date: "2026-05-24"
    severite: "HIGH"
    titre: "Bundle identity drift broke root adapter"
    l0_abstract: "Renaming SCRIBE bundle adapters without moving the canonical folder makes `./scribe` fail with FileNotFoundError."
    cause_racine: "The bundle identity changed in root adapters and installer templates while the physical folder and bundle graph output stayed on the older `scribe-engineering-rag` layout."
    detection: "`./scribe context` and `./scribe challenge` failed while looking for `.agent/workflow/scribe-engineering-local-causal-retrieval/scripts/scribe_memory.py`."
    correction: "Move the bundle folder atomically, keep root adapters as shims, route bundle Graphify output under `scribe-out/bundle-graph/`, and bind the identity contract to tests."
    test_binding: ".agent/workflow/scribe-engineering-local-causal-retrieval/tests/test_scribe_memory.py::test_bundle_identity_matches_adapter_paths"
    liens_causaux:
      prevenu_par: ["JOURNAL-037"]
      renforce: ["VAC-005", "PAT-005", "PAT-006", "PAT-012", "PAT-016"]
  - id: "SCAR-002"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-24"
    schema_patch_date: "2026-05-24"
    severite: "HIGH"
    titre: "Graphify hook contract drift"
    l0_abstract: "Graphify-generated hooks that emit unsupported fields or exit before consuming stdin recreate repeated PreToolUse/BeforeToolUse failures across agent hosts."
    cause_racine: "The hook contract lived in installed Graphify templates and global trusted registries, so fixing only the project hook left reinstall and Gemini paths able to reintroduce the same runtime failure."
    detection: "The user kept seeing `AvantUtilisationOutil failed` / `PreToolUse hook returned unsupported additionalContext`, then later Graphify hook stdin recurrence paths, after a local project hook cleanup."
    correction: "Patch active Graphify templates, keep a bundle `scribe graphify-hooks` guard, preserve upstreamable patch files, and treat VAC-004/PAT-022 as recurrence controls after reinstall or upgrade."
    test_binding: ".agent/workflow/scribe-engineering-local-causal-retrieval/tests/test_scribe_graphify_hooks.py"
    liens_causaux:
      prevenu_par: ["JOURNAL-016", "JOURNAL-041", "JOURNAL-043"]
      renforce: ["VAC-004", "PAT-022"]
  - id: "SCAR-003"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-25"
    schema_patch_date: "2026-05-25"
    severite: "HIGH"
    titre: "Refresh token rotation race"
    l0_abstract: "Refresh-token rotation must be single-winner; creating the successor before conditionally revoking the current token lets a token family branch under concurrent refresh."
    cause_racine: "The repository created the next refresh token first and then updated the current token by id only, so concurrent requests that both read the current token as active could each mint a successor."
    detection: "Baseline auth audit identified that `RefreshSessionUseCase` reads token state before `PrismaRefreshTokenRepository.rotate`, while `rotate` lacked a `revokedAt: null` single-winner guard."
    correction: "Rotate now conditionally revokes the current token inside the transaction before creating the successor; a second winner raises `RefreshTokenRotationConflictError`, and the use case maps it to reuse-detected family revocation plus 401."
    test_binding: "jjk-messenger/backend/scripts/verify-refresh-rotation.ts"
    liens_causaux:
      prevenu_par: ["JOURNAL-063"]
      renforce: ["VAC-009", "GHOST-005", "VAC-003"]
vaccins:
  - id: "VAC-001"
    tier: "cold"
    titre: "Next 16 lint CLI"
    l0_abstract: "After upgrading to Next.js 16, keep linting on ESLint CLI with native flat config; never keep `next lint`."
    virus: "Leaving `next lint` or FlatCompat-based Next extends after Next 16 creates broken lint workflows."
    antidote: "Use `eslint .` and import `eslint-config-next/core-web-vitals` plus `eslint-config-next/typescript` directly in `eslint.config.mjs`."
    contexte: "Frontend upgrades to Next.js 16."
  - id: "VAC-002"
    tier: "warm"
    status: "ACTIVE"
    date_creation: "2026-05-23"
    schema_patch_date: "2026-05-23"
    source: "JOURNAL-007"
    scope: "security"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-007"
      observable: "WebSocket sendMessage accepted unknown payloads and logged message content before the hardening patch."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "WebSocket input validation and PII-safe logs"
    l0_abstract: "All Socket.IO client payloads must be validated server-side and message content must never be logged in clear text."
    virus: "Trusting socket event payload shape or logging chat message content creates input abuse and PII leakage risk."
    antidote: "Parse unknown socket payloads defensively, reject invalid values, and log only metadata such as user IDs and content length."
    contexte: "Backend Socket.IO message ingestion."
    validite:
      derniere_verif: "2026-05-23"
      verifie_par: "JOURNAL-007"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-003"
    tier: "warm"
    status: "ACTIVE"
    date_creation: "2026-05-23"
    schema_patch_date: "2026-05-23"
    source: "JOURNAL-009"
    scope: "security"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-009"
      observable: "Auth register/login routes were public and had no request throttling before the hardening patch."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Auth endpoint rate limiting"
    l0_abstract: "Public auth endpoints must rate limit attempts before validation and controller execution."
    virus: "Leaving login/register unlimited makes brute-force and account abuse cheap."
    antidote: "Apply request rate limiting before validation/controllers on auth routes, and preserve a 429 Retry-After response."
    contexte: "Backend auth boundary."
    liens_causaux:
      complements: ["VAC-002"]
    validite:
      derniere_verif: "2026-05-23"
      verifie_par: "JOURNAL-009"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-004"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-23"
    schema_patch_date: "2026-05-23"
    source: "JOURNAL-016"
    scope: "dev"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-016"
      observable: "Graphify generators and the global Gemini trusted hook registry emitted unsupported `additionalContext` until patched."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Graphify PreToolUse schema compatibility"
    l0_abstract: "Graphify-generated PreToolUse hooks must never emit unsupported fields and must consume stdin before exiting."
    virus: "Reinstalling Graphify from any unpatched installation, leaving global trusted hooks stale, or using a hook command that exits without reading stdin recreates PreToolUse failures."
    antidote: "Use stdin-consuming hook commands for Codex and Gemini trusted registries, patch every active Graphify installation template, rerun `graphify codex install`, and verify no executable hook source contains `additionalContext`, `hookSpecificOutput`, legacy echo-only Gemini allow commands, or any graphify hook command that exits before reading stdin."
    contexte: "Graphify Codex/Gemini hook generation, project hook compatibility, and global trusted hook registries."
    liens_causaux:
      complements: ["PAT-001", "PAT-002", "PAT-003", "PAT-004"]
      prevenu_par: ["JOURNAL-016"]
    validite:
      derniere_verif: "2026-05-24"
      verifie_par: "JOURNAL-041"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-005"
    tier: "warm"
    status: "ACTIVE"
    date_creation: "2026-05-23"
    schema_patch_date: "2026-05-23"
    source: "JOURNAL-021"
    scope: "bundle"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-021"
      observable: "Pyrefly reported missing imports after SCRIBE scripts moved out of repository-root `scripts/` into the bundle."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Rootless bundle after compatibility moves"
    l0_abstract: "When SCRIBE tooling moves into the bundle, keep the canonical CLI and implementation inside the bundle; root adapters are legacy opt-in only."
    virus: "Leaving active root `scribe` or root `scripts/` beside the bundle makes multi-agent sessions edit or execute the wrong surface."
    antidote: "Use `.agent/workflow/scribe-engineering-local-causal-retrieval/scribe` as the canonical command, generate root files only with explicit `install --with-root-adapters`, and never store generated adapters inside the bundle."
    contexte: "SCRIBE/TENOR bundle migration, Pyrefly stale diagnostics, and cross-project installer behavior."
    liens_causaux:
      renforce: ["PAT-005", "PAT-006"]
      prevenu_par: ["JOURNAL-021"]
    validite:
      derniere_verif: "2026-05-24"
      verifie_par: "JOURNAL-038"
      verdict: "still_valid"
    status_log: []
    tier_log:
      - date: "2026-05-25"
        from: "hot"
        to: "warm"
        reason: "App security work resumed; SCAR-003 now needs hot retrieval more than completed bundle rootless compatibility."
  - id: "VAC-006"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-24"
    schema_patch_date: "2026-05-24"
    source: "JOURNAL-037"
    scope: "bundle"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-037"
      observable: "Root `./scribe` and shims pointed to `scribe-engineering-local-causal-retrieval` while the physical bundle still existed as `scribe-engineering-rag`, causing FileNotFoundError."
    confirmed_sessions:
      - session: "JOURNAL-051"
        observation: "Global Gemini prompt and host `.agent/rules/scribe.md` now point to the canonical bundle docs/CLI instead of the legacy workflow path."
    human_validated: false
    validated_by_session: null
    titre: "Atomic SCRIBE bundle identity"
    l0_abstract: "Any SCRIBE bundle identity change must move directory, adapters, installer templates, docs, tests, and generated-output paths in one validated change."
    virus: "Changing only root adapters or docs creates a split-brain bundle where one LLM writes the new name and another still reads or executes the old layout."
    antidote: "Use one canonical folder name and bundle-local CLI path, install rootlessly by default, generate legacy adapters from templates only on opt-in, store generated bundle graphs under `scribe-out/bundle-graph/`, keep global host prompts and `.agent/rules/scribe.md` pointed at `docs/scribe.md`, and validate with bundle-command stats, installer dry-run, tests, and graph build."
    contexte: "Multi-agent SCRIBE/TENOR bundle maintenance and cross-project installation."
    liens_causaux:
      source: "JOURNAL-037"
      renforce: ["SCAR-001", "VAC-005", "PAT-005", "PAT-006", "PAT-012", "PAT-016"]
    validite:
      derniere_verif: "2026-05-24"
      verifie_par: "JOURNAL-051"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-007"
    tier: "warm"
    status: "ACTIVE"
    date_creation: "2026-05-24"
    schema_patch_date: "2026-05-24"
    source: "JOURNAL-052"
    scope: "frontend"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-052"
      observable: "Next.js 16.2.6 with Turbopack failed on localhost because `next/font/google` generated a CSS URL to `@vercel/turbopack-next/internal/font/google/font` that could not be resolved."
    confirmed_sessions:
      - session: "JOURNAL-052"
        observation: "Removing `next/font/google` from `frontend/src/app/layout.tsx` and defining font variables in `globals.css` made lint, build, and localhost routing pass."
    human_validated: false
    validated_by_session: "JOURNAL-052"
    titre: "Next font Google Turbopack fallback"
    l0_abstract: "When Next 16 Turbopack cannot resolve the internal Google font loader, avoid `next/font/google` and keep font variables in CSS."
    virus: "Keeping `Geist` imports from `next/font/google` can block the dev server with an internal Turbopack font module resolution error."
    antidote: "Remove the `next/font/google` import from `layout.tsx`, keep body classes static, and define `--font-geist-sans` / `--font-geist-mono` fallbacks in `globals.css`."
    contexte: "Next.js 16 frontend dev server and build pipeline."
    liens_causaux:
      source: "JOURNAL-052"
      complements: ["VAC-001"]
    validite:
      derniere_verif: "2026-05-24"
      verifie_par: "JOURNAL-052"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-008"
    tier: "warm"
    status: "ACTIVE"
    date_creation: "2026-05-25"
    schema_patch_date: "2026-05-25"
    source: "JOURNAL-053"
    scope: "frontend"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-053"
      observable: "React/Next showed a hydration mismatch on `/login` where the client DOM had extension-injected attributes such as `bis_skin_checked`, `bis_register`, `cz-shortcut-listen`, and `__processed_*` that were absent from server HTML."
    confirmed_sessions:
      - session: "JOURNAL-053"
        observation: "Root layout initially suppressed root hydration noise and tried an inline `<head>` cleanup for known extension attributes."
      - session: "JOURNAL-059"
        observation: "The inline `<head>` cleanup itself collided with the extension-injected script, so the app now avoids manual root-layout `<head>` and runs a scoped client sanitizer from `<body>`."
      - session: "JOURNAL-065"
        observation: "A client sanitizer mounted with React was still too late for attributes injected before hydration; a parser-time body bootstrap now starts cleanup and observation before the app providers hydrate."
    human_validated: false
    validated_by_session: "JOURNAL-053"
    titre: "Browser extension hydration attributes"
    l0_abstract: "If React hydration mismatches show `bis_*`, `cz-shortcut-listen`, or `__processed_*`, treat browser extension DOM mutation as the cause before changing page state."
    virus: "Chasing app SSR state bugs when the mismatch is only extension-injected attributes wastes time; adding manual root-layout `<head>` scripts can create a new hydration comparison target."
    antidote: "Keep deterministic SSR, keep root `suppressHydrationWarning`, avoid manual `<head>` in App Router root layouts, and run a static parser-time body bootstrap before React providers plus a scoped client sanitizer for known extension attributes/scripts. If a `chrome-extension://` script still appears before React loads, verify in an extension-free/incognito browser because that DOM mutation is outside application control."
    contexte: "Next.js 16 dev overlay hydration diagnostics on login/register pages."
    liens_causaux:
      source: "JOURNAL-053"
      complements: ["VAC-007"]
    validite:
      derniere_verif: "2026-05-25"
      verifie_par: "JOURNAL-065"
      verdict: "updated_antidote"
    status_log: []
    tier_log: []
  - id: "VAC-009"
    tier: "warm"
    status: "ACTIVE"
    date_creation: "2026-05-25"
    schema_patch_date: "2026-05-25"
    source: "JOURNAL-063"
    scope: "backend"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-063"
      observable: "`npm run test:refresh-rotation` proves the first rotation creates one successor and the second same-token rotation raises `RefreshTokenRotationConflictError` without creating another token."
    confirmed_sessions:
      - session: "JOURNAL-063"
        observation: "Backend build passed after mapping rotation conflicts to reuse-detected family revocation and 401."
    human_validated: false
    validated_by_session: "JOURNAL-063"
    titre: "Single-winner refresh token rotation"
    l0_abstract: "Refresh-token rotation must atomically revoke the current token before minting its successor."
    virus: "Creating a successor token before a conditional revoke lets concurrent refreshes branch one refresh-token family into multiple valid successors."
    antidote: "Inside the transaction, update the current token with `where: { id, revokedAt: null }`; if no row changes, treat it as reuse/conflict, revoke the family, and return 401."
    contexte: "Backend HttpOnly refresh-token session boundary."
    liens_causaux:
      source: "JOURNAL-063"
      prevenu_par: ["SCAR-003"]
      renforce: ["GHOST-005", "VAC-003"]
    validite:
      derniere_verif: "2026-05-25"
      verifie_par: "JOURNAL-063"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-010"
    tier: "warm"
    status: "ACTIVE"
    date_creation: "2026-05-25"
    schema_patch_date: "2026-05-25"
    source: "JOURNAL-068"
    scope: "backend"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-068"
      observable: "`npm run lint` initially failed because the backend had no lint script; after adding ESLint, the first strict pass exposed 144 problems before fixes."
    confirmed_sessions:
      - session: "JOURNAL-068"
        observation: "`npm run lint`, `npm run lint:full`, `npm run build`, and `npm run test:refresh-rotation` passed after adding the backend ESLint surface and fixing unsafe types."
      - session: "JOURNAL-069"
        observation: "VS Code/TS Server still flagged `scripts/verify-refresh-rotation.ts` until the scripts folder received its own `scripts/tsconfig.json` and `lint:types` ran that project explicitly."
    human_validated: false
    validated_by_session: "JOURNAL-068"
    titre: "Build green is not lint green"
    l0_abstract: "Never claim backend cleanliness from `tsc` alone; run the backend lint command and the full JSON report when the user asks for unfiltered diagnostics."
    virus: "Treating a passing TypeScript build as proof that lint diagnostics are clean hides missing scripts, unsafe `any`, stale console usage, and type-only import drift."
    antidote: "Use `npm run lint` for strict type-aware lint, keep standalone TypeScript scripts covered by a local tsconfig, and use `npm run lint:full` for the unfiltered JSON report that includes every backend TypeScript file, messages, counts, and rule timing stats."
    contexte: "Backend production hardening and editor red diagnostics."
    liens_causaux:
      source: "JOURNAL-068"
      renforce: ["INV-F003", "SCAR-003", "GHOST-005"]
    validite:
      derniere_verif: "2026-05-25"
      verifie_par: "JOURNAL-069"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-011"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-25"
    schema_patch_date: "2026-05-25"
    source: "JOURNAL-072"
    scope: "auth"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-072"
      observable: "A rejected login raised a generic Error, so the global middleware returned HTTP 500 and the frontend displayed an internal-server message for normal invalid credentials."
    confirmed_sessions:
      - session: "JOURNAL-072"
        observation: "Invalid login now returns HTTP 401 with the public message `Identifiants invalides`; PostgreSQL connectivity and bcrypt hash storage were verified."
    human_validated: false
    validated_by_session: "JOURNAL-072"
    titre: "Auth expected failures must carry HTTP status"
    l0_abstract: "Expected auth failures such as invalid credentials must throw status-bearing 4xx errors, never generic Errors that become 500s."
    virus: "Throwing a plain Error for invalid login, duplicate auth state, or denied session makes the global middleware treat user/business failures as server crashes."
    antidote: "Create explicit status-bearing auth errors and make the global middleware expose raw messages only for 4xx while preserving generic 500 masking."
    contexte: "Backend auth use cases and global HTTP error middleware."
    liens_causaux:
      source: "JOURNAL-072"
      complements: ["VAC-003", "GHOST-005"]
    validite:
      derniere_verif: "2026-05-25"
      verifie_par: "JOURNAL-072"
      verdict: "still_valid"
    status_log: []
    tier_log: []
patterns:
  - id: "PAT-001"
    tier: "cold"
    titre: "Canonical Graphify Root"
    l0_abstract: "Keep the canonical Graphify graph at repository root `graphify-out/` so Codex hooks and AGENTS.md resolve it automatically."
    contexte: "Graphify installation for this project."
    pourquoi: "A subfolder graph can be valid for manual reading, but Codex hooks installed by `graphify codex install` check root `graphify-out/`; duplicating graphs creates stale-memory risk."
  - id: "PAT-002"
    tier: "warm"
    status: "ACTIVE"
    date: "2026-05-23"
    schema_patch_date: "2026-05-23"
    scope: "dev"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-008"
      observable: "After adding scribe doctor tooling, Graphify promoted tooling nodes above app nodes until .graphifyignore excluded SCRIBE/TENOR files."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Graphify app/tooling scope separation"
    l0_abstract: "Keep root graphify-out focused on the jjk-messenger app; exclude SCRIBE/TENOR tooling and prefix app queries with APP_SCOPE."
    pourquoi: "The app graph loses architectural signal when agent tooling becomes top-ranked god nodes; filtering tooling preserves app navigation while direct file inspection remains available for SCRIBE code."
    contexte: "Graphify root graph and future codebase queries."
    liens_causaux:
      source: "JOURNAL-008"
    validite:
      derniere_verif: "2026-05-23"
      verifie_par: "JOURNAL-008"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "PAT-003"
    tier: "hot"
    status: "ACTIVE"
    date: "2026-05-23"
    schema_patch_date: "2026-05-23"
    scope: "dev"
    evidence:
      type: "OBSERVED"
