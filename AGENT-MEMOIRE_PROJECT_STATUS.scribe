invariants:
  - id: "INV-F001"
    status: "active"
    l0_abstract: "Maintain senior production engineering posture across the session."
  - id: "INV-F002"
    status: "active"
    l0_abstract: "Never hardcode secrets; use environment configuration."
  - id: "INV-F003"
    status: "active"
    l0_abstract: "Preserve existing behavior; avoid regressions."
  - id: "INV-F004"
    status: "active"
    l0_abstract: "Deliver complete code without placeholders."
  - id: "INV-F005"
    status: "active"
    l0_abstract: "Explain to the user in French; keep code identifiers and comments in English."
  - id: "INV-F006"
    status: "active"
    l0_abstract: "Consult SCRIBE before code changes."
  - id: "INV-F007"
    status: "active"
    l0_abstract: "Require human validation before irreversible actions."
  - id: "INV-F008"
    status: "active"
    l0_abstract: "Bind critical or high scars to tests."
  - id: "INV-F009"
    status: "active"
    l0_abstract: "Update SCRIBE incrementally; never overwrite historical memory."
  - id: "INV-F010"
    status: "active"
    l0_abstract: "Read Graphify report first when graphify-out is present."
scars: []
vaccins:
  - id: "VAC-001"
    titre: "Next 16 lint CLI"
    l0_abstract: "After upgrading to Next.js 16, keep linting on ESLint CLI with native flat config; never keep `next lint`."
    virus: "Leaving `next lint` or FlatCompat-based Next extends after Next 16 creates broken lint workflows."
    antidote: "Use `eslint .` and import `eslint-config-next/core-web-vitals` plus `eslint-config-next/typescript` directly in `eslint.config.mjs`."
    contexte: "Frontend upgrades to Next.js 16."
  - id: "VAC-002"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-23"
    schema_patch_date: "2026-05-23"
    source: "JOURNAL-007"
    scope: "security"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-007"
      observable: "WebSocket sendMessage accepted unknown payloads and logged message content before the hardening patch."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "WebSocket input validation and PII-safe logs"
    l0_abstract: "All Socket.IO client payloads must be validated server-side and message content must never be logged in clear text."
    virus: "Trusting socket event payload shape or logging chat message content creates input abuse and PII leakage risk."
    antidote: "Parse unknown socket payloads defensively, reject invalid values, and log only metadata such as user IDs and content length."
    contexte: "Backend Socket.IO message ingestion."
    validite:
      derniere_verif: "2026-05-23"
      verifie_par: "JOURNAL-007"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-003"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-23"
    schema_patch_date: "2026-05-23"
    source: "JOURNAL-009"
    scope: "security"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-009"
      observable: "Auth register/login routes were public and had no request throttling before the hardening patch."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Auth endpoint rate limiting"
    l0_abstract: "Public auth endpoints must rate limit attempts before validation and controller execution."
    virus: "Leaving login/register unlimited makes brute-force and account abuse cheap."
    antidote: "Apply request rate limiting before validation/controllers on auth routes, and preserve a 429 Retry-After response."
    contexte: "Backend auth boundary."
    liens_causaux:
      complements: ["VAC-002"]
    validite:
      derniere_verif: "2026-05-23"
      verifie_par: "JOURNAL-009"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-004"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-23"
    schema_patch_date: "2026-05-23"
    source: "JOURNAL-016"
    scope: "dev"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-016"
      observable: "Graphify generators and the global Gemini trusted hook registry emitted unsupported `additionalContext` until patched."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Graphify PreToolUse schema compatibility"
    l0_abstract: "Graphify-generated PreToolUse hooks must never emit unsupported fields and must consume stdin before exiting."
    virus: "Reinstalling Graphify from any unpatched installation, leaving global trusted hooks stale, or using a hook command that exits without reading stdin recreates PreToolUse failures."
    antidote: "Use a stdin-consuming Codex hook command (`python3 -c \"import sys; sys.stdin.read()\" # graphify hook`), patch every Graphify installation, sanitize global trusted hooks, rerun `graphify codex install`, and verify no executable hook source contains `additionalContext`, `hookSpecificOutput`, or the stdin-broken legacy command."
    contexte: "Graphify Codex/Gemini hook generation, project hook compatibility, and global trusted hook registries."
    liens_causaux:
      complements: ["PAT-001", "PAT-002", "PAT-003", "PAT-004"]
      prevenu_par: ["JOURNAL-016"]
    validite:
      derniere_verif: "2026-05-24"
      verifie_par: "JOURNAL-034"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "VAC-005"
    tier: "hot"
    status: "ACTIVE"
    date_creation: "2026-05-23"
    schema_patch_date: "2026-05-23"
    source: "JOURNAL-021"
    scope: "dev"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-021"
      observable: "Pyrefly reported missing imports after SCRIBE scripts moved out of repository-root `scripts/` into the bundle."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Root script shims after bundle moves"
    l0_abstract: "When SCRIBE tooling moves into the bundle, keep repository-root `scripts/*.py` shims for static analyzers and legacy imports."
    virus: "Removing the root script path entirely after a bundle migration makes editors and type checkers report missing imports even when `./scribe` still works."
    antidote: "Keep root `scripts/` as shim-only adapters that re-export the canonical bundle modules, ignore that directory in Graphify, and teach `scribe install` to recreate the shims idempotently."
    contexte: "SCRIBE/TENOR bundle migration, Pyrefly diagnostics, and cross-project installer behavior."
    liens_causaux:
      renforce: ["PAT-005", "PAT-006"]
      prevenu_par: ["JOURNAL-021"]
    validite:
      derniere_verif: "2026-05-23"
      verifie_par: "JOURNAL-021"
      verdict: "still_valid"
    status_log: []
    tier_log: []
patterns:
  - id: "PAT-001"
    titre: "Canonical Graphify Root"
    l0_abstract: "Keep the canonical Graphify graph at repository root `graphify-out/` so Codex hooks and AGENTS.md resolve it automatically."
    contexte: "Graphify installation for this project."
    pourquoi: "A subfolder graph can be valid for manual reading, but Codex hooks installed by `graphify codex install` check root `graphify-out/`; duplicating graphs creates stale-memory risk."
  - id: "PAT-002"
    tier: "hot"
    status: "ACTIVE"
    date: "2026-05-23"
    schema_patch_date: "2026-05-23"
    scope: "dev"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-008"
      observable: "After adding scribe doctor tooling, Graphify promoted tooling nodes above app nodes until .graphifyignore excluded SCRIBE/TENOR files."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Graphify app/tooling scope separation"
    l0_abstract: "Keep root graphify-out focused on the jjk-messenger app; exclude SCRIBE/TENOR tooling and prefix app queries with APP_SCOPE."
    pourquoi: "The app graph loses architectural signal when agent tooling becomes top-ranked god nodes; filtering tooling preserves app navigation while direct file inspection remains available for SCRIBE code."
    contexte: "Graphify root graph and future codebase queries."
    liens_causaux:
      source: "JOURNAL-008"
    validite:
      derniere_verif: "2026-05-23"
      verifie_par: "JOURNAL-008"
      verdict: "still_valid"
    status_log: []
    tier_log: []
  - id: "PAT-003"
    tier: "hot"
    status: "ACTIVE"
    date: "2026-05-23"
    schema_patch_date: "2026-05-23"
    scope: "dev"
    evidence:
      type: "OBSERVED"
      source: "JOURNAL-011"
      observable: "A controlled crash-test proved scribe doctor fails closed on corruptions while the canonical SCRIBE remains clean."
    confirmed_sessions: []
    human_validated: false
    validated_by_session: null
    titre: "Doctor guard around SCRIBE evolution"
    l0_abstract: "Every SCRIBE evolution must run scribe doctor before and after the memory delta."
    pourquoi: "The crash-test proved doctor catches duplicate IDs, missing V3.2 fields, broken links, and unlogged status mutations; making it a pre/post guard prevents silent memory corruption."
    contexte: "TENOR/SCRIBE workflow updates and all future causal memory writes."
    liens_causaux:
      source: "JOURNAL-011"
      renforce: ["JOURNAL-010"]
    validite:
      derniere_verif: "2026-05-23"
      verifie_par: "JOURNAL-011"
