{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.20.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "DEBUG=app:* nodemon --exec \"ts-node --files\" index.ts",
    "build": "tsc",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:types": "tsc --project tsconfig.lint.json --noEmit --pretty false && tsc --project scripts/tsconfig.json --noEmit --pretty false",
    "lint:eslint": "eslint --no-cache --max-warnings=0 index.ts \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:eslint:full": "eslint --no-cache --max-warnings=0 --format json --stats index.ts \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:full": "npm run lint:types && npm run lint:eslint:full",
    "test:e2e-smoke": "ts-node scripts/e2e-smoke.ts",
    "test:refresh-rotation": "ts-node scripts/verify-refresh-rotation.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "chat",
    "messenger",
    "websocket",
    "clean-architecture"
  ],
  "author": "Jack-Josias",
  "license": "ISC",
  "description": "Backend pour l'application de messagerie instantanée JJK Messenger",
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.8.2",
    "socket.io": "^4.8.1",
    "ws": "^8.18.2",
    "zod": "^3.25.31"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.15.23",
    "debug": "^4.3.5",
    "dotenv": "^16.5.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4"
  }
}
